# Control Plane 镜像（多阶段构建）
# 设计依据：§71、§72
# 支持 linux/amd64 与 linux/arm64（适配群晖 DSM Container Manager 等平台）

FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS build
ARG TARGETOS
ARG TARGETARCH
ENV GOTOOLCHAIN=auto
ENV GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
WORKDIR /src
# gen 为 replace 依赖，需一并拷贝
COPY gen/go.mod gen/go.sum* ./gen/
COPY server/go.mod server/go.sum ./server/
WORKDIR /src/server
RUN go mod download
WORKDIR /src
COPY gen ./gen
COPY server ./server
COPY migrations ./migrations
WORKDIR /src/server
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -o /out/server ./cmd/server \
 && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -o /out/migrate ./cmd/migrate
# 预创建数据目录并赋予 nonroot 用户 (UID 65532) 写权限
RUN mkdir -p /data/ca /data/secrets && chown -R 65532:65532 /data

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/server /app/server
COPY --from=build /out/migrate /app/migrate
COPY --from=build /src/migrations /migrations
COPY --from=build --chown=nonroot:nonroot /data /data
ENV AIE_HTTP_ADDR=:8080
ENV AIE_GRPC_ADDR=:9090
ENV AIE_CA_DIR=/data/ca
# migrate 示例: /app/migrate -dir /migrations up
USER nonroot:nonroot
ENTRYPOINT ["/app/server"]
