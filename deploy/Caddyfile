{
    # IP 访问通常不发送 SNI；容器端口映射后需用部署地址选择证书。
    default_sni {$AIE_DOMAIN}
}

{$AIE_DOMAIN} {
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }
    @control path /api/* /mcp
    handle @control {
        reverse_proxy control-plane:8080
    }
    handle {
        reverse_proxy admin-web:80
    }
}
