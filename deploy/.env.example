# AI Employee Platform 生产与 DSM 部署环境配置示例
# 复制为 .env 文件生效：cp .env.example .env

# 镜像配置（默认指向 GHCR 发布的官方多架构镜像，自动适配 x86_64 与 ARM64）
AIE_CONTROL_PLANE_IMAGE=ghcr.io/divad1111/ai-employee-control-plane:latest
AIE_ADMIN_IMAGE=ghcr.io/divad1111/ai-employee-admin:latest

# 数据持久化目录（绑定到本地目录，镜像升级不丢失数据）
# 群晖 DSM 建议设置为例如: /volume1/docker/ai-employee/data/postgres
AIE_PG_DATA_DIR=./data/postgres
AIE_SERVER_DATA_DIR=./data/server

# PostgreSQL 数据库配置
POSTGRES_USER=aie
POSTGRES_PASSWORD=aie
POSTGRES_DB=aie
POSTGRES_PORT=5432

# 中心控制面服务端口
AIE_HTTP_PORT=8080
AIE_GRPC_PORT=9090
AIE_ADMIN_PORT=8088

# 运行模式: production（生产无演示假数据） / development
AIE_ENV=production
AIE_SEED_DEMO=0
