# AI Employee Platform：首次安装配置模板（Docker Compose 自动读取同目录 .env）。
# 详细说明和各平台操作步骤：docs/ENV_CONFIGURATION.md、docs/DEPLOYMENT_GUIDE.md。
# 每行一个 KEY=value，不要在行末添加续行反斜杠；不要提交真实 .env 到 Git。
# 已有部署保留数据库密码、CA、Secret/备份主密钥；不能通过重新生成 .env 轮换密钥。
# 安全加固前的旧数据先按 docs/SECURITY_HARDENING_2026-10-25.md 迁移。
#
# 【推荐：一次生成新安装所需的四个独立随机值，不覆盖已有 .env】
# 在 deploy 目录执行，替换域名和实际镜像标签；域名参数不含协议、端口或路径。
# Windows PowerShell（内置 .NET，无需 Python / OpenSSL）：
# .\generate-env.ps1 -Domain employee.example.com -ServerImage aie-control-plane:local -AdminImage aie-admin:local
# Windows CMD，或 PowerShell 执行策略阻止直接运行脚本时（仅本次进程）：
# powershell.exe -NoProfile -ExecutionPolicy Bypass -File .\generate-env.ps1 -Domain employee.example.com -ServerImage aie-control-plane:local -AdminImage aie-admin:local
# macOS / Linux / 群晖 DSM SSH（系统 sh + OpenSSL，无需 Python）：
# sh ./generate-env.sh --domain employee.example.com --server-image aie-control-plane:local --admin-image aie-admin:local
# 上述 local 标签用于源码构建；在线拉取须改成实际仓库版本，离线须与导入镜像标签一致。
#
# 【手动生成：每次随机 32 字节，输出 64 位十六进制文本，四项不能共用一个值】
# Windows PowerShell 5.1 / 7（无需 Python，以下整行执行）：
# $aieRng = [System.Security.Cryptography.RandomNumberGenerator]::Create(); foreach ($aieKeyName in @('POSTGRES_PASSWORD','AIE_SECRET_MASTER_KEY','AIE_BACKUP_MASTER_KEY','AIE_SETUP_TOKEN')) { $aieBytes = New-Object byte[] 32; $aieRng.GetBytes($aieBytes); $aieKeyName + '=' + [BitConverter]::ToString($aieBytes).Replace('-','').ToLowerInvariant() }; $aieRng.Dispose()
# Windows CMD：先运行 powershell.exe -NoProfile，再粘贴上一行原生 PowerShell 命令。
# macOS / Linux / 群晖 DSM SSH（需 openssl，以下整行执行）：
# for aie_key_name in POSTGRES_PASSWORD AIE_SECRET_MASTER_KEY AIE_BACKUP_MASTER_KEY AIE_SETUP_TOKEN; do printf '%s=' "$aie_key_name"; openssl rand -hex 32; done
# 将四行结果填入下方对应项；不要把生成结果发到聊天或普通日志。
# AIE_BACKUP_PREVIOUS_KEY 取自实际旧密钥，不随机生成。
# AIE_SOFTWARE_SIGNING_KEY 是发布方的 Ed25519 原始公钥 Base64，不使用上述随机值；见专门手册。

# 【镜像：两个业务镜像必填，优先固定已核验版本或 repository@sha256:digest】
# 示例为源码构建标签；使用在线发布/离线导入时须与实际镜像名称和标签完全一致。
AIE_CONTROL_PLANE_IMAGE=aie-control-plane:security-20261025

# 与控制面版本配套的管理后台镜像，必须与本地已构建/导入或远程发布标签一致。
AIE_ADMIN_IMAGE=aie-admin:security-20261025

# 可选依赖镜像；完全离线时也须提前导入，版本变更前确认兼容性。
AIE_POSTGRES_IMAGE=postgres:16-alpine

# 目录权限初始化镜像，可选；完全离线时也需提前导入。
AIE_INIT_IMAGE=busybox:1.37.0

# 内置 HTTPS 网关镜像，仅启用 public profile 时使用。
AIE_GATEWAY_IMAGE=caddy:2-alpine

# 【持久化：相对路径以 Compose 文件所在目录为基准，不随运行命令目录变化】
# PostgreSQL 数据目录。群晖示例：/volume1/docker/ai-employee/data/postgres。
AIE_PG_DATA_DIR=./data/postgres

# 服务数据目录：CA、Vault、附件、备份等。保留整个目录并保护读取权限。
# 群晖示例：/volume1/docker/ai-employee/data/server。
AIE_SERVER_DATA_DIR=./data/server

# 【数据库：内置 PostgreSQL 默认不发布宿主机端口】
# 初次建库用户名/数据库名；已有数据库不能靠改这两个变量重命名。
POSTGRES_USER=aie

# 必填：独立随机密码，生产至少 20 字符，推荐上文生成的 64 字符。
# 已有数据库实际密码不随 .env 改动而变化，需先执行数据库改密并同步配置。
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_32_BYTES

# 内置数据库初次创建的数据库名，已有数据库不能靠修改此项重命名。
POSTGRES_DB=aie

# 可选：非空时覆盖 control-plane/migrate 的数据库连接；默认按上述项连接容器 postgres:5432。
# 含特殊字符的 URI 密码必须 URL 编码；优先留空避免 URI 转义问题。
# 内置 postgres 服务仍会启动；外部数据库部署还需按实际拓扑调整 Compose。
AIE_DATABASE_URL=

# 【网络：下列 HTTP/Admin 是回环 HTTP 后端，不会自动创建 HTTPS 监听】
# 宿主机 REST API 端口 -> 容器 8080，仅绑定 127.0.0.1；改为 9080 仍是 HTTP。
AIE_HTTP_PORT=8080

# gRPC 对外端口 -> 容器 9090；同时通过 enrollment endpoint 告知工作站。
AIE_GRPC_PORT=9090

# 默认仅服务器本机可连；远程工作站改为服务器内网 IP，如 192.168.4.243。
# 同时限制防火墙允许的工作站来源；HTTPS gateway 不代理此 mTLS 连接。
AIE_GRPC_BIND_IP=127.0.0.1

# 宿主机 Admin 端口 -> 容器 80，仅绑定 127.0.0.1；改为 9088 仍是 HTTP。
AIE_ADMIN_PORT=8088

# 生产必须保持 production，启用强密钥校验、HTTPS 地址校验和管理员 MFA 要求。
AIE_ENV=production

# 演示业务数据开关，生产保持 0；不用于创建生产管理员。
AIE_SEED_DEMO=0

# 必填：客户端实际使用的完整 HTTPS 基址，如 https://employee.example.com。
# 使用非默认 HTTPS 端口时带端口，如 https://employee.example.com:9443。
# 只声明地址，不创建监听、不签发证书；修改后重建 control-plane。
AIE_PUBLIC_SERVER_URL=https://CHANGE_ME.example.com

# 内置 Caddy 的站点域名/IP，不含 https:// 或路径；现有模板使用宿主机 80/443。
# 启动内置网关必须添加 --profile public 并保留同目录 Caddyfile。
# 私有 IP 如 192.168.4.243 使用 Caddy 本地 CA，浏览器/工作站需安装其根证书。
# 使用其他 HTTPS 代理时此项不配置该代理，需在代理自身设置证书和监听。
AIE_DOMAIN=CHANGE_ME.example.com

# 【三组独立随机值：生产各至少 32 字符，推荐上文生成的 64 位十六进制文本】
# Secret Vault 与 TOTP 等敏感数据加密主密钥；丢失/直接替换会导致旧密文无法解密。
AIE_SECRET_MASTER_KEY=CHANGE_ME_RANDOM_32_BYTES

# 备份包及备份目标凭据的加密主密钥；独立保管，恢复旧备份时需要对应旧密钥。
AIE_BACKUP_MASTER_KEY=CHANGE_ME_DIFFERENT_RANDOM_32_BYTES

# 可选：轮换期间的实际上一把备份主密钥，首次部署留空，不是新随机值。
# 不能替代离线密钥迁移；旧数据迁移、旧备份恢复见安全加固文档。
AIE_BACKUP_PREVIOUS_KEY=

# /setup 首次初始化口令，与管理员登录密码/工作站 Enrollment Token 无关。
# 通过受控渠道提供给初始化操作者；初始化完成后不能用它重置管理员。
AIE_SETUP_TOKEN=CHANGE_ME_ANOTHER_RANDOM_32_BYTES

# 【代理与软件源信任】
# 逗号分隔的可信代理 IP/CIDR，决定是否接受其 X-Forwarded-* 头。
# 默认只信任内置 gateway 固定地址；使用其他代理时填实际来源，不填工作站地址。
# 修改 Docker 子网时同步调整 Compose 网络和本项；禁止 0.0.0.0/0 或 ::/0。
AIE_TRUSTED_PROXIES=172.30.20.10/32

# 允许远程软件源访问的 HTTPS 主机名，逗号分隔；含重定向目标，不含协议/路径。
# 生产软件源仅允许 HTTPS 默认 443，不提供通配符；不能绕过签名校验。
AIE_SOFTWARE_ALLOWED_HOSTS=api.github.com,github.com,release-assets.githubusercontent.com,objects.githubusercontent.com

# 可选：发布方 Ed25519 原始 32 字节公钥的标准 Base64（通常 44 字符）。
# 生产自动接收远程 release 时必需；留空不影响基础服务启动，但相关导入会被拒绝。
# 不填 PEM、DER、私钥、随机口令或 SHA256；不是“随便生成一个 key”即可校验已有发布。
# 使用自己的发布源时，在发布机生成密钥对，用私钥签名，仅将匹配公钥填到这里。
# 各平台生成/格式转换命令见 docs/ENV_CONFIGURATION.md 的“软件发布签名公钥”。
AIE_SOFTWARE_SIGNING_KEY=
